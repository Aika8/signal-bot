# Copy to .env and fill in. .env is git-ignored. Secrets via env vars only.

# --- PostgreSQL (consumed by docker-compose and the app) ---
POSTGRES_DB=signalbot
POSTGRES_USER=signalbot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Watchlist (<= 10 US symbols, comma-separated) ---
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL

# --- Portfolio source: paper (DB) | file (hand-edited YAML) | private (broker module) ---
PORTFOLIO_SOURCE=paper
PORTFOLIO_FILE=portfolio.yml

# --- Market data (Alpaca, free IEX plan) ---
ALPACA_ENABLED=false
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- News & earnings (Finnhub, 60 req/min) ---
FINNHUB_ENABLED=false
FINNHUB_TOKEN=

# --- Decision engine (Claude) ---
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=

# --- Telegram bot ---
# Reuse the stopped storyteller bot: paste its token below and set TELEGRAM_ENABLED=true.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=signal_bot
TELEGRAM_CHAT_ID=

# --- Paper wallet ---
PAPER_SEED_KZT=1000000
FEE_PER_SHARE_USD=0.005
FEE_PER_ORDER_USD=1.00

# --- Trigger engine ---
DRY_RUN=true

# --- FX rates (config for now) ---
FX_USD_KZT=525.0
FX_EUR_KZT=565.0
